# --- 策略组 (Proxy Groups) ---
# 策略组通用配置
group_common:
  group_common_select:
    &group_common_select {
      type: select,
      interval: 600,
      timeout: 3000,
      max-failed-times: 3,
      empty-fallback: REJECT,
      url: 'https://www.apple.com/library/test/success.html',
      lazy: true,
    }
  group_common_auto:
    &group_common_auto {
      type: url-test,
      interval: 600,
      timeout: 3000,
      max-failed-times: 3,
      empty-fallback: REJECT,
      url: 'https://www.apple.com/library/test/success.html',
      lazy: true,
      tolerance: 50,
      include-all: true,
      exclude-type: 'DIRECT',
      icon: 'https://fastly.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/Auto.png',
      hidden: true,
    }
  group_common_load:
    &group_common_load {
      type: load-balance,
      interval: 600,
      timeout: 3000,
      max-failed-times: 3,
      empty-fallback: REJECT,
      url: 'https://www.apple.com/library/test/success.html',
      lazy: true,
      strategy: 'sticky-sessions',
      include-all: true,
      exclude-type: 'DIRECT',
      icon: 'https://fastly.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/Round_Robin.png',
      hidden: true,
    }
# 通用代理节点组
proxies_common:
  proxies_default:
    &proxies_default {
      proxies:
        [
          '默认代理',
          '手动选择',
          '自动选择',
          '负载均衡',
          '香港策略',
          '日本策略',
          '美国策略',
          '新加坡策略',
          '台湾策略',
          '低倍率节点',
          '高倍率节点',
          '其他节点',
          '游戏节点',
        ],
    }
  proxies_direct:
    &proxies_direct {
      proxies:
        [
          '默认代理',
          '手动选择',
          '自动选择',
          '负载均衡',
          '直连',
          '香港策略',
          '日本策略',
          '美国策略',
          '新加坡策略',
          '台湾策略',
          '低倍率节点',
